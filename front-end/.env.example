NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# enabled: demo completa (MSW cuida de tudo no npm run dev).
# catalog: modo híbrido — catálogo e agenda mockados; auth e arena REAIS (Django).
